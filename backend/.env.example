# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=5000
NODE_ENV=development

# MongoDB Atlas free (M0) cluster connection string.
# Use a dedicated app database user, not your Atlas account owner login.
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/report-generator

# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Where the frontend is served from, needed for CORS + cookie settings.
CLIENT_URL=http://localhost:5173

# Used once by scripts/seedAdmin.js to create the first admin account.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=change-this-before-running-seed
